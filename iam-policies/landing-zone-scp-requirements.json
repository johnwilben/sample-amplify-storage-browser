{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSTSAssumeRole",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole",
        "sts:AssumeRoleWithWebIdentity"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "REPLACE_WITH_YOUR_ORG_ID"
        }
      }
    },
    {
      "Sid": "AllowCognitoIdentityOperations",
      "Effect": "Allow",
      "Action": [
        "cognito-identity:GetCredentialsForIdentity",
        "cognito-identity:GetId",
        "cognito-identity:GetOpenIdToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowS3CrossAccountAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "REPLACE_WITH_YOUR_ORG_ID"
        }
      }
    }
  ]
}

# Cross-Account Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# Microsoft Entra ID Configuration
# ============================================
ENTRA_TENANT_ID=your-tenant-id-here
ENTRA_METADATA_URL=https://login.microsoftonline.com/YOUR_TENANT_ID/federationmetadata/2007-06/federationmetadata.xml

# ============================================
# AWS Account IDs
# ============================================
# Account A - Where Amplify and Cognito are deployed
AMPLIFY_ACCOUNT_ID=111111111111

# Account B - First storage account
STORAGE_ACCOUNT_B_ID=222222222222

# Account C - Second storage account
STORAGE_ACCOUNT_C_ID=333333333333

# ============================================
# AWS Cognito Configuration
# ============================================
# Get these values after deploying Amplify
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
COGNITO_USER_POOL_DOMAIN=https://xxxxx.auth.us-east-1.amazoncognito.com

# ============================================
# S3 Bucket Configuration
# ============================================
# Account B bucket
ACCOUNT_B_BUCKET_NAME=your-bucket-name-account-b
ACCOUNT_B_REGION=us-east-1

# Account C bucket
ACCOUNT_C_BUCKET_NAME=your-bucket-name-account-c
ACCOUNT_C_REGION=us-east-1

# ============================================
# IAM Role ARNs
# ============================================
# These are created by the deployment script
ACCOUNT_B_ROLE_ARN=arn:aws:iam::222222222222:role/AmplifyStorageCrossAccountRole
ACCOUNT_C_ROLE_ARN=arn:aws:iam::333333333333:role/AmplifyStorageCrossAccountRole

# ============================================
# AWS Organization (for Landing Zone)
# ============================================
AWS_ORGANIZATION_ID=o-xxxxxxxxxx

# ============================================
# Optional: Landing Zone Configuration
# ============================================
LANDING_ZONE_ENABLED=true
CONTROL_TOWER_ENABLED=true
